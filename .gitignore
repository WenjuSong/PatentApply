!/templates/unpublished.example.json
!/templates/作品说明书.md
!/版权准备/
/版权准备/*
!/版权准备/补充材料PDF模板-北京-v2-20261022/
/版权准备/补充材料PDF模板-北京-v2-20261022/*
!/版权准备/补充材料PDF模板-北京-v2-20261022/build_pdf.py

